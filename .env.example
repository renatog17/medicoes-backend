# Copy to .env and choose credentials for the new PostgreSQL database.
POSTGRES_DB=devdb
POSTGRES_USER=devuser
POSTGRES_PASSWORD=replace-with-a-strong-password
FATURAMENTO_HABILITADO=false
# Defina o preco real em reais por m3 antes de habilitar.
FATURAMENTO_VALOR_M3=
BANCO_HABILITADO=false
BANCO_URL=http://localhost:9090
BANCO_TOKEN=
BANCO_TIMEOUT_MS=5000
BANCO_SINCRONIZACAO_MS=900000
