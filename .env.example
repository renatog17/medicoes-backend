# Copy to .env and choose credentials for the new PostgreSQL database.
POSTGRES_DB=devdb
POSTGRES_USER=devuser
POSTGRES_PASSWORD=replace-with-a-strong-password
FATURAMENTO_HABILITADO=false
# Preco em reais por m3 de gas.
FATURAMENTO_VALOR_M3=1.35
BANCO_HABILITADO=false
BANCO_URL=http://banco-api:8080
BANCO_TOKEN=
BANCO_TIMEOUT_MS=5000
BANCO_SINCRONIZACAO_MS=1800000
